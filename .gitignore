.venv/
# Local secrets (TABPFN_TOKEN, ...), loaded with `uv run --env-file .env`. Never committed.
.env
.env.*
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.lcov
htmlcov/
.tmp/
data/*
!data/manifest.json
!data/open/
# Recorded scores of third-party rows stay local, except those of the CC0 Netflix file.
!data/scores/
data/scores/*
!data/scores/netflix-churn.json
!.env.example
