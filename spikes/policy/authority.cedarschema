entity Agent;
entity Tool;
type Envelope = { tenant: String, acts_as: String, scopes: Set<String>, expires_at: Long };
type ToolFacts = { acts_as: String, scope: String, tier: String, reversible: Bool };
type RequestFacts = { resource_tenant: String };
type ApprovalFacts = { exists: Bool, granted_by: String, snapshot: String };
action "act" appliesTo {
  principal: Agent,
  resource: Tool,
  context: {
    now: Long,
    state_snapshot: String,
    envelope: Envelope,
    tool: ToolFacts,
    request: RequestFacts,
    approval: ApprovalFacts,
  }
};
